{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KellyMurphy/vectorcraft/blob/main/docs/formats/vectorcraft-embroidery.schema.json",
  "title": "Embroidery data in .vectorcraft documents",
  "description": "A node's `stitch` settings and the document's `embroidery` setup. See vectorcraft-embroidery.md. Ranges are what programs sew with; values outside them are clamped on reading, not refused.",
  "$defs": {
    "stitch": {
      "title": "Stitch settings (a node's `stitch`)",
      "type": "object",
      "properties": {
        "kind": { "enum": ["running", "bean", "satin", "zigzag", "satinShape", "fill", "patternBorder", "manual", "auto"], "default": "running" },
        "length": { "type": "number", "minimum": 0.3, "maximum": 12, "description": "Stitch length, mm." },
        "spacing": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Satin zig or fill row spacing, mm." },
        "angle": { "type": "number", "description": "Fill row direction, degrees counter-clockwise.", "default": 0 },
        "width": { "type": "number", "minimum": 0.3, "maximum": 40, "description": "Satin or zigzag width (0.3-12 mm), or pattern border width (1-40 mm)." },
        "thread": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/byte" }, { "$ref": "#/$defs/byte" }, { "$ref": "#/$defs/byte" }],
          "minItems": 3,
          "maxItems": 3,
          "description": "sRGB thread colour."
        },
        "pull": { "type": "number", "minimum": 0, "maximum": 3, "description": "Pull compensation, mm: satins wider, fill rows longer." },
        "pullPercent": { "type": "number", "minimum": 0, "maximum": 30, "description": "More pull compensation, % of the satin's width or the fill row's length." },
        "push": { "type": "number", "minimum": 0, "maximum": 3, "description": "Push compensation, mm: satin columns shorter at their ends, fills shorter across their rows." },
        "underlay": { "enum": ["none", "auto", "center", "edge", "zigzag", "fill"], "default": "none", "description": "Missing means none; new objects are given auto." },
        "stagger": { "type": "integer", "minimum": 2, "maximum": 8, "description": "Fill rows before the needle holes line up again." },
        "motif": { "enum": ["diamonds", "waves", "circles", "scales", "herringbone"], "description": "Fill: a carved motif." },
        "motifSize": { "type": "number", "minimum": 3, "maximum": 60, "description": "The carved motif's repeat, mm." },
        "pattern": { "type": "string", "description": "Pattern border: a border pattern id (a starter, or one of document.embroidery.patterns)." },
        "flip": { "type": "boolean", "default": false },
        "passes": { "type": "integer", "enum": [3, 5, 7, 9], "description": "Bean: times each stitch is sewn." },
        "thinUnder": { "type": "number", "minimum": 0.2, "maximum": 3 },
        "wideOver": { "type": "number", "minimum": 2, "maximum": 12 },
        "border": { "type": "number", "minimum": 0.5, "maximum": 6, "description": "Fill: a satin border's width, mm." },
        "rails": { "type": "boolean", "default": false },
        "startAt": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2, "description": "Running, bean, zigzag: where the needle starts, [x, y] mm in document space." },
        "puff": { "type": "number", "minimum": 1, "maximum": 6, "description": "Puff: the foam's thickness, mm." },
        "keepCovered": { "type": "boolean", "default": false, "description": "Fill: keep the rows under objects sewn later on top of it." },
        "trimBefore": { "type": "boolean", "default": false },
        "trimAfter": { "type": "boolean", "default": false },
        "stopBefore": { "type": "string", "enum": ["stop", "placeFabric", "trimFabric"], "description": "Stop the machine before the object: a plain stop, placing appliqué fabric, or trimming it. Readers treat an id they don't know as a plain stop." }
      }
    },
    "setup": {
      "title": "Embroidery setup (`document.embroidery`)",
      "type": "object",
      "properties": {
        "trimJumpsOver": { "type": ["number", "null"], "minimum": 0.5, "maximum": 100, "default": 3, "description": "null: never trim on length." },
        "stitchMovesUnder": { "type": "number", "minimum": 0, "maximum": 5, "default": 1 },
        "speed": { "type": "number", "minimum": 100, "maximum": 1500, "default": 600, "description": "The machine's speed, stitches per minute (for the sewing time estimate)." },
        "machineFormat": { "type": "string", "default": "dst", "description": "The format the panels' Export button writes: dst, pes, jef or exp (a newer version's value is kept; DST is used in its place)." },
        "hideTravel": { "type": "boolean", "default": true, "description": "Travel under a fill or satin shape sewn later is sewn there rather than jumped." },
        "autoStart": { "type": "boolean", "default": true, "description": "Lines without startAt are entered nearest where the needle is." },
        "minStitch": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.3, "description": "The shortest stitch sewn, mm (the fabric's minStitch when longer)." },
        "overlap": { "type": "number", "minimum": 0, "maximum": 3, "default": 0.5, "description": "How far a fill's rows still reach under objects sewn on top of it, mm." },
        "order": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Object ids sewn first, in this order." },
        "patterns": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/pattern" }],
            "required": ["id"],
            "properties": { "id": { "type": "string", "minLength": 1 } }
          }
        },
        "sewOut": { "$ref": "#/$defs/sewOut" },
        "fabric": { "$ref": "#/$defs/fabric" },
        "hoop": { "$ref": "vchoop.schema.json#/$defs/hoop" },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A thread chart: the fields of a .vcthreads file other than format and version.",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "brand": { "type": "string" },
              "weight": { "type": "string" },
              "author": { "type": "string" },
              "license": { "type": "string" },
              "source": { "type": "string" },
              "description": { "type": "string" },
              "threads": { "type": "array", "items": { "$ref": "vcthreads.schema.json#/$defs/thread" } }
            }
          }
        },
        "chart": { "type": "string", "description": "The id of the chart the design's colours are matched against." }
      }
    },
    "fabric": {
      "description": "The document's fabric: the fields of a .vcfabric file other than format, version and units.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "satinSpacing": { "$ref": "vcfabric.schema.json#/properties/satinSpacing" },
        "fillSpacing": { "$ref": "vcfabric.schema.json#/properties/fillSpacing" },
        "pull": { "$ref": "vcfabric.schema.json#/properties/pull" },
        "pullPercent": { "$ref": "vcfabric.schema.json#/properties/pullPercent" },
        "push": { "$ref": "vcfabric.schema.json#/properties/push" },
        "satinCenterUnder": { "$ref": "vcfabric.schema.json#/properties/satinCenterUnder" },
        "satinZigzagOver": { "$ref": "vcfabric.schema.json#/properties/satinZigzagOver" },
        "shapeEdgeOver": { "$ref": "vcfabric.schema.json#/properties/shapeEdgeOver" },
        "minStitch": { "$ref": "vcfabric.schema.json#/properties/minStitch" }
      }
    },
    "sewOut": {
      "title": "A sew-out test record (`document.embroidery.sewOut`)",
      "type": "object",
      "properties": {
        "fabric": { "type": "string" },
        "machine": { "type": "string" },
        "notes": { "type": "string" },
        "swatches": { "type": "array", "items": { "$ref": "#/$defs/swatch" } }
      }
    },
    "swatch": {
      "title": "One swatch of a test sheet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The section's letter and the swatch's number, as sewn on the sheet (A3)." },
        "section": { "type": "string", "description": "The test sheet section (see vectorcraft-embroidery.md)." },
        "label": { "type": "string", "description": "What the swatch tests, in words." },
        "objects": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "The ids of the objects it is sewn from." },
        "result": { "enum": ["", "pass", "fail"], "default": "", "description": "Empty: not judged yet. Readers treat other values as not judged, and keep them." },
        "notes": { "type": "string" }
      }
    },
    "pattern": {
      "description": "A border pattern: the fields of a .vcborder file other than format, version and units.",
      "type": "object",
      "required": ["name", "width", "length", "repeat"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "source": { "type": "string" },
        "description": { "type": "string" },
        "width": { "$ref": "vcborder.schema.json#/$defs/size" },
        "length": { "$ref": "vcborder.schema.json#/$defs/size" },
        "repeat": { "type": "array", "items": { "$ref": "vcborder.schema.json#/$defs/part" }, "minItems": 1 },
        "corner": { "type": "array", "items": { "$ref": "vcborder.schema.json#/$defs/part" } }
      }
    },
    "byte": { "type": "integer", "minimum": 0, "maximum": 255 }
  }
}
