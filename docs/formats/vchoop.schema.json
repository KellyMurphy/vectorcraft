{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KellyMurphy/vectorcraft/blob/main/docs/formats/vchoop.schema.json",
  "title": "VectorCraft hoop list file (.vchoop), version 1",
  "description": "Embroidery hoops: their sewing fields. See vchoop.md.",
  "type": "object",
  "required": ["format", "version", "hoops"],
  "properties": {
    "format": { "const": "vectorcraft-hoops" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "units": { "const": "mm" },
    "hoops": { "type": "array", "items": { "$ref": "#/$defs/hoop" }, "minItems": 1, "maxItems": 1000 }
  },
  "$defs": {
    "hoop": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0, "description": "The sewing field's width, mm (programs use 10-2000)." },
        "height": { "type": "number", "exclusiveMinimum": 0, "description": "The sewing field's height, mm (programs use 10-2000)." },
        "round": { "type": "boolean", "default": false },
        "machines": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
