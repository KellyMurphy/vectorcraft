{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KellyMurphy/vectorcraft/blob/main/docs/formats/vcfabric.schema.json",
  "title": "VectorCraft fabric profile file (.vcfabric), version 1",
  "description": "The settings a fabric wants, filling in what objects' stitch settings leave unset. See vcfabric.md. Ranges are what programs sew with; values outside them are clamped when used, but negative or non-finite numbers are refused.",
  "type": "object",
  "required": ["format", "version"],
  "properties": {
    "format": { "const": "vectorcraft-fabric" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "units": { "const": "mm" },
    "id": { "type": "string", "description": "Lower-case letters and digits joined by dashes; made from name when absent or empty." },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string", "description": "An SPDX identifier, or text." },
    "source": { "type": "string" },
    "description": { "type": "string" },
    "satinSpacing": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Satin and satin shape spacing, mm." },
    "fillSpacing": { "type": "number", "minimum": 0.1, "maximum": 10, "description": "Fill row spacing, mm." },
    "pull": { "type": "number", "minimum": 0, "maximum": 3, "description": "Pull compensation, mm." },
    "pullPercent": { "type": "number", "minimum": 0, "maximum": 30, "description": "More pull compensation, % of the width or row length." },
    "push": { "type": "number", "minimum": 0, "maximum": 3, "description": "Push compensation, mm." },
    "satinCenterUnder": { "type": "number", "minimum": 0.3, "maximum": 12 },
    "satinZigzagOver": { "type": "number", "minimum": 0.3, "maximum": 12 },
    "shapeEdgeOver": { "type": "number", "minimum": 0.3, "maximum": 12 }
  }
}
