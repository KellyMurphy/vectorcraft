{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KellyMurphy/vectorcraft/blob/main/docs/formats/vcmotif.schema.json",
  "title": "VectorCraft motif file (.vcmotif), version 1",
  "description": "One tile of a pattern repeated both ways on a lattice: carved into fills or sewn tile by tile. See vcmotif.md.",
  "type": "object",
  "required": [
    "format",
    "version",
    "name",
    "size",
    "offsets",
    "parts"
  ],
  "properties": {
    "format": {
      "const": "vectorcraft-motif"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "units": {
      "const": "mm"
    },
    "id": {
      "type": "string",
      "description": "Lower-case letters and digits joined by dashes; made from name when absent or empty."
    },
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "description": "An SPDX identifier, or text."
    },
    "source": {
      "type": "string",
      "description": "A URL, or the design the motif was taken from."
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "stitched",
        "carve"
      ],
      "default": "stitched"
    },
    "size": {
      "$ref": "vcborder.schema.json#/$defs/size",
      "description": "The tile's size at its own scale, mm."
    },
    "offsets": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "vcborder.schema.json#/$defs/point"
        },
        {
          "$ref": "vcborder.schema.json#/$defs/point"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "The lattice: offsets from a tile to its neighbours, mm at size; 0.01–1000 mm long, not along one line."
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "vcborder.schema.json#/$defs/part"
      },
      "minItems": 1,
      "description": "The tile's lines, in its own space."
    }
  }
}
